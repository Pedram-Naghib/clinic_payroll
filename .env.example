# Copy this file to .env and adjust before running `docker compose up`.
# .env is gitignored -- never commit real credentials.

POSTGRES_DB=clinic_payroll
POSTGRES_USER=clinic
POSTGRES_PASSWORD=devpassword

# Only used by locally-run (non-Docker) tools, e.g. `alembic upgrade head`
# from your host machine. Matches the docker-compose db service's exposed port.
DATABASE_URL=postgresql+psycopg://clinic:devpassword@localhost:5432/clinic_payroll

# Signs session cookies -- generate a real random value before deploying:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=dev-only-change-me
